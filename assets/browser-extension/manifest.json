{
  "manifest_version": 3,
  "name": "Muxics Browser Bridge",
  "description": "Connects your browser's YouTube Music session to the Muxics desktop app.",
  "version": "1.0.2",
  "key": "",
  "permissions": ["cookies", "alarms"],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://google.com/*",
    "https://*.google.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Muxics Browser Bridge",
    "default_popup": "popup.html"
  }
}
