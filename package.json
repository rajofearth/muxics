{
  "type": "module",
  "name": "muxics",
  "version": "1.0.5",
  "author": "Rajofearth <rajofearth@proton.me>",
  "description": "A modern music player built with Electron",
  "packageManager": "pnpm@11.13.0",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "predev": "tsup --config tsup.electron.config.ts",
    "dev": "concurrently -k \"vite --port 5173\" \"tsup --config tsup.electron.config.ts --watch\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && tsup --config tsup.electron.config.ts",
    "bench:driver": "vitest run --config vitest.bench.config.ts benchmarks/driver",
    "bench:driver:headless": "cross-env MUXICS_BENCH_HEADLESS=1 vitest run --config vitest.bench.config.ts benchmarks/driver",
    "bench:startup": "vitest run --config vitest.bench.config.ts benchmarks/runner",
    "bench:startup:headless": "cross-env MUXICS_BENCH_HEADLESS=1 vitest run --config vitest.bench.config.ts benchmarks/runner",
    "typecheck": "tsc --noEmit",
    "package": "pnpm run build && cross-env ELECTRON_BUILDER_7Z_FILTER=BCJ2 electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "colorthief": "^3.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "music-metadata": "^11.14.0",
    "react": "latest",
    "react-dom": "latest",
    "youtubei.js": "^17.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "playwright": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
